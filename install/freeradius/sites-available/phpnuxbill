		if (&Tmp-String-8 != "hs-slots=%{control:Simultaneous-Use}") {
			update request {
				&Tmp-String-8 := "%{sql:INSERT IGNORE INTO nuxr_hs_admission (username, slot, state, token, nas, acct_session_id, calling_station_id, request_authenticator, session_user, created_at, updated_at) SELECT UNHEX('%{Tmp-String-3}'), t.n, 'ENDED', MD5(CONCAT(UUID(), RAND(), t.n)), '', '', '', '', '', UTC_TIMESTAMP(6), UTC_TIMESTAMP(6) FROM (SELECT a.d * 10 + b.d + 1 AS n FROM (SELECT 0 AS d UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9) a CROSS JOIN (SELECT 0 AS d UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9) b) t WHERE t.n <= %{control:Simultaneous-Use} ORDER BY t.n}"
			}
			update request {
				&Tmp-String-8 := "hs-slots=%{sql:SELECT COUNT(*) FROM nuxr_hs_admission WHERE username = UNHEX('%{Tmp-String-3}') AND slot <= %{control:Simultaneous-Use}}"
			}
		}
		if (&Tmp-String-8 != "hs-slots=%{control:Simultaneous-Use}") {
			update request {
				&Tmp-String-0 := "nuxr-hs-admission=reject:slots"
			}
			attr_filter.access_reject
			update reply {
				&Reply-Message := "Session verification failed"
			}
			reject
		}
		# ---- H-2B 4: the token of this claim
		update control {
			&Tmp-String-5 := "%{randstr:hhhhhhhhhhhhhhhh}"
			&Tmp-String-9 := "none"
		}
		if (&control:Tmp-String-5 !~ /^[0-9a-f]{32}$/) {
			update request {
				&Tmp-String-0 := "nuxr-hs-admission=reject:token"
			}
			attr_filter.access_reject
			update reply {
				&Reply-Message := "Session verification failed"
			}
			reject
		}
		# ---- H-2B 5: an exact retransmission of the claiming request re-uses its PENDING claim (a=<token> | a=-)
		update control {
			&Tmp-String-6 := "%{sql:SELECT CONCAT('a=', COALESCE((SELECT token FROM nuxr_hs_admission WHERE username = UNHEX('%{Tmp-String-3}') AND state = 'PENDING' AND nas = '%{NAS-IP-Address}' AND acct_session_id = '%{Acct-Session-Id}' AND calling_station_id = '%{Calling-Station-Id}' AND request_authenticator = '%{Tmp-String-7}' LIMIT 1), '-'))}"
		}
		if (&control:Tmp-String-6 =~ /^a=([0-9a-f]{32})$/) {
			update control {
				&Tmp-String-5 := "%{1}"
				&Tmp-String-9 := "attached"
			}
			update request {
				&Tmp-String-9 := "hs-claim=%{sql:UPDATE nuxr_hs_admission SET attach_count = attach_count + 1, updated_at = UTC_TIMESTAMP(6) WHERE username = UNHEX('%{Tmp-String-3}') AND token = '%{control:Tmp-String-5}' AND state = 'PENDING' AND nas = '%{NAS-IP-Address}' AND acct_session_id = '%{Acct-Session-Id}' AND calling_station_id = '%{Calling-Station-Id}' AND request_authenticator = '%{Tmp-String-7}'}"
			}
		}
		elsif (&control:Tmp-String-6 == "a=-") {
			update control {
				&Tmp-String-9 := "created"
			}
			# ---- H-2B 6: claim v2 (pre-check + ONE conditional UPDATE)
			update request {
				&Tmp-String-4 := "%{sql:SELECT CONCAT(IF(COUNT(a.slot) < p.l AND COALESCE(SUM(a.slot > p.l), 0) = 0, 'free', 'full'), '/', LOWER(HEX(p.k)), '/', p.l) FROM (SELECT UNHEX('%{Tmp-String-3}') AS k, %{control:Simultaneous-Use} AS l) AS p LEFT JOIN nuxr_hs_admission AS a ON a.username = p.k AND a.state <> 'ENDED' GROUP BY p.k, p.l}"
			}
			if (&Tmp-String-4 == "free/%{Tmp-String-3}/%{control:Simultaneous-Use}") {
				update request {
					&Tmp-String-9 := "hs-claim=%{sql:UPDATE nuxr_hs_admission SET prev_token = token, prev_state = state, state = 'PENDING', token = '%{control:Tmp-String-5}', nas = '%{NAS-IP-Address}', acct_session_id = '%{Acct-Session-Id}', calling_station_id = '%{Calling-Station-Id}', request_authenticator = '%{Tmp-String-7}', session_user = '%{SQL-User-Name}', attach_count = 0, created_at = UTC_TIMESTAMP(6), updated_at = UTC_TIMESTAMP(6), confirmed_at = NULL, last_acct_at = NULL, ended_at = NULL, end_reason = NULL WHERE username = UNHEX('%{Tmp-String-3}') AND slot <= %{control:Simultaneous-Use} AND state = 'ENDED' ORDER BY slot LIMIT 1}"
				}
			}
			else {
				update request {
					&Tmp-String-9 := "hs-claim=full"
				}
			}
			# ---- H-2B 6a: no free slot - verify the ACTIVE slots on their NAS (never a PENDING one), release ONE proven gone,
			# claim once more. Candidates (at most 12, least recent accounting first): token/nas/calling_station_id.
			if (&Tmp-String-9 != "hs-claim=1") {
				update request {
					&Tmp-String-1 := "%{sql:SELECT CONCAT('v=', COUNT(*), ';', COALESCE(GROUP_CONCAT(CONCAT(x.token, '/', x.nas, '/', x.calling_station_id) ORDER BY x.o, x.slot SEPARATOR ','), '')) FROM (SELECT token, nas, calling_station_id, slot, COALESCE(last_acct_at, created_at) AS o FROM nuxr_hs_admission WHERE username = UNHEX('%{Tmp-String-3}') AND state = 'ACTIVE' ORDER BY o, slot LIMIT 12) AS x}"
				}
				if (&Tmp-String-1 =~ /^v=([1-9][0-9]?);([0-9a-f]{32}\/[0-9]{1,3}(\.[0-9]{1,3}){3}\/[0-9A-Fa-f:.-]{1,32}(,[0-9a-f]{32}\/[0-9]{1,3}(\.[0-9]{1,3}){3}\/[0-9A-Fa-f:.-]{1,32}){0,11})$/) {
					update request {
						&Tmp-String-1 := "%{2}"
					}
					update control {
						&Tmp-String-7 !* ANY
						&Tmp-String-8 !* ANY
						&Tmp-String-4 !* ANY
					}
					# a reply Exec-Program / Exec-Program-Wait would make rlm_exec run THAT program instead
					update reply {
						&Exec-Program !* ANY
						&Exec-Program-Wait !* ANY
					}
					# ONE explicit mapping decides: release only for exit 0 (ok) WITH the verdict GONE and a token in the
					# control list; LIVE (exit 1), ERROR (exit 2), timeout / kill (fail), anything unexpected: refused.
					nuxr_hotspot_slot_verifier {
						reject = 1
						fail = 1
						ok = 1
						handled = 1
						invalid = 1
						userlock = 1
						notfound = 1
						noop = 1
						updated = 1
					}
					if (ok && (&control:Tmp-String-7 == "GONE") && (&control:Tmp-String-8 =~ /^[0-9a-f]{32}$/)) {
						# audit FIRST (never an unaudited automatic release), then the release - both conditional on the slot still
						# being ACTIVE with exactly that token; either failing: nothing more happens, refused
						update request {
							&Tmp-String-8 := "hs-audit=%{sql:INSERT INTO nuxr_hs_admission_audit (at, action, outcome, username, slot, token, actor, evidence) SELECT UTC_TIMESTAMP(6), 'verified_release', 'proven_gone', username, slot, token, 'nuxr_hotspot_slot_verifier', LEFT(CONCAT('nas ', nas, ' calling_station_id ', calling_station_id, ' acct_session_id ', acct_session_id, ' verifier %{control:Tmp-String-4} requested_by_claim %{control:Tmp-String-5}'), 1024) FROM nuxr_hs_admission WHERE username = UNHEX('%{Tmp-String-3}') AND token = '%{control:Tmp-String-8}' AND state = 'ACTIVE'}"
						}
						if (&Tmp-String-8 != "hs-audit=1") {
							update request {
								&Tmp-String-0 := "nuxr-hs-admission=reject:verified-audit"
							}
							attr_filter.access_reject
							update reply {
								&Reply-Message := "Session verification failed"
							}
							reject
						}
						update request {
							&Tmp-String-8 := "hs-release=%{sql:UPDATE nuxr_hs_admission SET state = 'ENDED', ended_at = UTC_TIMESTAMP(6), updated_at = UTC_TIMESTAMP(6), end_reason = 'verified_gone' WHERE username = UNHEX('%{Tmp-String-3}') AND token = '%{control:Tmp-String-8}' AND state = 'ACTIVE'}"
						}
						if (&Tmp-String-8 != "hs-release=1") {
							update request {
								&Tmp-String-0 := "nuxr-hs-admission=reject:verified-release"
							}
							attr_filter.access_reject
							update reply {
								&Reply-Message := "Session verification failed"
							}
							reject
						}
						update request {
							&Tmp-String-4 := "%{sql:SELECT CONCAT(IF(COUNT(a.slot) < p.l AND COALESCE(SUM(a.slot > p.l), 0) = 0, 'free', 'full'), '/', LOWER(HEX(p.k)), '/', p.l) FROM (SELECT UNHEX('%{Tmp-String-3}') AS k, %{control:Simultaneous-Use} AS l) AS p LEFT JOIN nuxr_hs_admission AS a ON a.username = p.k AND a.state <> 'ENDED' GROUP BY p.k, p.l}"
						}
						if (&Tmp-String-4 == "free/%{Tmp-String-3}/%{control:Simultaneous-Use}") {
							update request {
								&Tmp-String-9 := "hs-claim=%{sql:UPDATE nuxr_hs_admission SET prev_token = token, prev_state = state, state = 'PENDING', token = '%{control:Tmp-String-5}', nas = '%{NAS-IP-Address}', acct_session_id = '%{Acct-Session-Id}', calling_station_id = '%{Calling-Station-Id}', request_authenticator = '%{Tmp-String-7}', session_user = '%{SQL-User-Name}', attach_count = 0, created_at = UTC_TIMESTAMP(6), updated_at = UTC_TIMESTAMP(6), confirmed_at = NULL, last_acct_at = NULL, ended_at = NULL, end_reason = NULL WHERE username = UNHEX('%{Tmp-String-3}') AND slot <= %{control:Simultaneous-Use} AND state = 'ENDED' ORDER BY slot LIMIT 1}"
							}
						}
						else {
							update request {
								&Tmp-String-9 := "hs-claim=full"
							}
						}
					}
				}
			}
		}
		else {
			update request {
				&Tmp-String-0 := "nuxr-hs-admission=reject:attach-read"
			}
			attr_filter.access_reject
			update reply {
				&Reply-Message := "Session verification failed"
			}
			reject
		}
		if (&Tmp-String-9 != "hs-claim=1") {
			# a claim UPDATE that committed but whose result was lost (connection drop, rlm_sql retry): this request never
			# sends an Access-Accept with its token, so it ends its own claim - only its token, only PENDING, only while no
			# retransmission re-used it. Usually matches nothing (no claim was made).
			if (&control:Tmp-String-9 == "created") {
				update request {
					&Tmp-String-8 := "hs-release=%{sql:UPDATE nuxr_hs_admission SET state = 'ENDED', ended_at = UTC_TIMESTAMP(6), updated_at = UTC_TIMESTAMP(6), end_reason = 'claim_failed' WHERE username = UNHEX('%{Tmp-String-3}') AND token = '%{control:Tmp-String-5}' AND state = 'PENDING' AND attach_count = 0}"
				}
			}
			update request {
				&Tmp-String-0 := "nuxr-hs-admission=reject:full"
			}
			attr_filter.access_reject
			update reply {
				&Reply-Message := "Session verification failed"
			}
			reject
		}
		# ---- H-2B 7: late-claim guard AFTER the claim: a late claim gets no Access-Accept; only its CREATOR releases it,
		# only its own token, only while PENDING and not re-used by a retransmission (that request may have sent an Accept)
		update request {
			&Tmp-String-6 := "%{expr:(%{time_since:us} - %l * 1000000 - %M) / 1000}"
		}
		if ((&Tmp-String-6 !~ /^[0-9]{1,9}$/) || (<integer>&Tmp-String-6 > 5000)) {
			if (&control:Tmp-String-9 == "created") {
				update request {
					&Tmp-String-8 := "hs-release=%{sql:UPDATE nuxr_hs_admission SET state = 'ENDED', ended_at = UTC_TIMESTAMP(6), updated_at = UTC_TIMESTAMP(6), end_reason = 'late_claim' WHERE username = UNHEX('%{Tmp-String-3}') AND token = '%{control:Tmp-String-5}' AND state = 'PENDING' AND attach_count = 0}"
				}
			}
			update request {
				&Tmp-String-0 := "nuxr-hs-admission=reject:late-claim"
			}
			attr_filter.access_reject
			update reply {
				&Reply-Message := "Session verification failed"
			}
			reject
		}
		# ---- H-2B 8: the per-claim correlation value (any Class from radreply / radgroupreply is replaced)
		update reply {
			&Class := "0x6e75786831%{control:Tmp-String-5}"
		}
		update request {
			&Tmp-String-0 := "nuxr-hs-admission=claim:%{control:Tmp-String-9}"
		}
	}
	Post-Auth-Type REJECT {
		attr_filter.access_reject
	}
}

