# ITC NetCore V1.0 fresh install - operator parameters and secrets (install/fresh/nuxr-fresh-install.sh --env-file).
#
# Copy to a protected location OUTSIDE the document root, for example /root/itc-netcore-install.env, then:
#   chmod 0600 /root/itc-netcore-install.env        (the installer refuses any other mode than 0600 / 0400,
#                                                   and a file that is not owned by the user running it)
# Or let the installer create it with generated passwords:
#   nuxr-fresh-install.sh --generate-secrets=/root/itc-netcore-install.env
# and then fill in the NUXR_DB_ADMIN_* lines and the non-secret parameters.
#
# Format: KEY=VALUE, one per line; '#' starts a comment only at the beginning of a line; no shell expansion
# (the file is parsed, never sourced). Values may be wrapped in single or double quotes.
# After the installation move every secret into the instance secret store and delete this file (or at least the
# NUXR_DB_ADMIN_PASSWORD line). The migration password is never written into config.php (checklist D3).

# --- database server -----------------------------------------------------------------------------------------------
# Host name or address the application (and the tools) use to reach the database; written into config.php.
# Port 3306 only (config.php has no port setting). 'localhost' means the local socket.
NUXR_DB_HOST=db.internal.example
# New instance database: [A-Za-z0-9_], 1-64 characters. It must not exist (then pass --create-db) or exist with
# ZERO tables, views, routines, events and triggers and the collation utf8mb4_general_ci.
NUXR_DB_NAME=itcnc_isp1

# Bootstrap administrator (an existing DBA account). Used only by the installer to prove the database is empty, to
# create the database (--create-db) and the accounts below, and to apply the reviewed GRANTs. It needs global SELECT,
# CREATE USER and GRANT OPTION (and CREATE for --create-db). Never stored by the installer.
NUXR_DB_ADMIN_USER=root
NUXR_DB_ADMIN_PASSWORD=

# --- accounts the installer creates (they must NOT exist yet) ---------------------------------------------------------
# Passwords: 20-128 characters from A-Z a-z 0-9 . _ ~ + = : , @ % ^ -  ; all different from each other.
# Migration (DDL) account: ALL PRIVILEGES on the instance database only; used for the base schema and migrate.php.
NUXR_DB_MIG_USER=itcnc_mig
NUXR_DB_MIG_PASSWORD=
# Application runtime account (config.php $db_user): least privilege from system/reseller/grants.php.
NUXR_DB_APP_USER=itcnc_app
NUXR_DB_APP_PASSWORD=
# FreeRADIUS runtime account: SELECT on the policy tables, accounting / admission writes, nothing on tbl_*.
NUXR_DB_RADIUS_USER=itcnc_radius
NUXR_DB_RADIUS_PASSWORD=

# Host part of the migration and application accounts = the address the application host connects FROM, as the
# database server sees it ('localhost' for a local socket). Example: 10.0.20.11
NUXR_DB_CLIENT_HOST=10.0.20.11
# Host part(s) of the FreeRADIUS account, separated by spaces (every address FreeRADIUS connects from).
NUXR_DB_RADIUS_HOSTS=10.0.20.12

# --- application ------------------------------------------------------------------------------------------------------
# The public HTTPS address of this instance, without a trailing slash (checklist B1 / B2 / B9).
NUXR_APP_URL=https://billing.example.net
