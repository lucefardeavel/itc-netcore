# ITC NetCore V1.0 - archive closed binary logs (PITR chain). The timer interval bounds the data-loss window when the
# database host is lost: choose it from the RPO the owner approves (README.md "RPO / RTO").
[Unit]
Description=ITC NetCore binlog archive
After=mariadb.service mysql.service

[Service]
Type=oneshot
ExecStart=/opt/itcnc/install/backup/nuxr-binlog-archive.sh --config /etc/itcnc/backup.conf
User=root
UMask=0077
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/itcnc /var/log/itcnc /run/lock
NoNewPrivileges=yes
