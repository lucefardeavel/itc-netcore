<?xml version="1.0" encoding="UTF-8"?>
<!-- Development/test only. Run through dev/test/run-tests.sh (PHP 8.2 container + disposable
     MariaDB 10.11 and MySQL 8.0). Never part of a production deployment. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="bootstrap.php"
         colors="false"
         cacheDirectory="/tmp/wp1-phpunit-cache"
         executionOrder="default"
         failOnRisky="true"
         failOnWarning="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="unit">
            <directory>Unit</directory>
            <exclude>Unit/Wp2</exclude>
            <exclude>Unit/Wp3a</exclude>
            <exclude>Unit/Wp3b</exclude>
            <exclude>Unit/Wp4</exclude>
            <exclude>Unit/Wp5a</exclude>
            <exclude>Unit/Wp5b</exclude>
            <exclude>Unit/Wp6a</exclude>
            <exclude>Unit/Wp6b</exclude>
            <exclude>Unit/Wp6c</exclude>
            <exclude>Unit/Wp7</exclude>
            <exclude>Unit/HotfixPaceXhrCsrf</exclude>
        </testsuite>
        <testsuite name="integration">
            <directory>Integration</directory>
            <exclude>Integration/Wp2</exclude>
            <exclude>Integration/Wp3a</exclude>
            <exclude>Integration/Wp3b</exclude>
            <exclude>Integration/Wp4</exclude>
            <exclude>Integration/Wp5a</exclude>
            <exclude>Integration/Wp5b</exclude>
            <exclude>Integration/Wp6a</exclude>
            <exclude>Integration/Wp6b</exclude>
            <exclude>Integration/Wp6c</exclude>
            <exclude>Integration/Wp7</exclude>
            <exclude>Integration/Wp8</exclude>
        </testsuite>
        <testsuite name="regression">
            <directory>Regression</directory>
        </testsuite>
        <testsuite name="wp2-unit">
            <directory>Unit/Wp2</directory>
        </testsuite>
        <testsuite name="wp2-integration">
            <directory>Integration/Wp2</directory>
        </testsuite>
        <testsuite name="wp2-http">
            <directory>Http</directory>
        </testsuite>
        <testsuite name="wp3a-unit">
            <directory>Unit/Wp3a</directory>
        </testsuite>
        <testsuite name="wp3a-integration">
            <directory>Integration/Wp3a</directory>
        </testsuite>
        <testsuite name="wp3b-unit">
            <directory>Unit/Wp3b</directory>
        </testsuite>
        <testsuite name="wp3b-integration">
            <directory>Integration/Wp3b</directory>
        </testsuite>
        <testsuite name="wp4-unit">
            <directory>Unit/Wp4</directory>
        </testsuite>
        <testsuite name="wp4-integration">
            <directory>Integration/Wp4</directory>
        </testsuite>
        <testsuite name="wp5a-unit">
            <directory>Unit/Wp5a</directory>
        </testsuite>
        <testsuite name="wp5a-integration">
            <directory>Integration/Wp5a</directory>
        </testsuite>
        <testsuite name="wp5b-unit">
            <directory>Unit/Wp5b</directory>
        </testsuite>
        <testsuite name="wp5b-integration">
            <directory>Integration/Wp5b</directory>
        </testsuite>
        <testsuite name="wp6a-unit">
            <directory>Unit/Wp6a</directory>
        </testsuite>
        <testsuite name="wp6a-integration">
            <directory>Integration/Wp6a</directory>
        </testsuite>
        <testsuite name="wp6b-unit">
            <directory>Unit/Wp6b</directory>
        </testsuite>
        <testsuite name="wp6b-integration">
            <directory>Integration/Wp6b</directory>
        </testsuite>
        <testsuite name="wp6c-unit">
            <directory>Unit/Wp6c</directory>
        </testsuite>
        <testsuite name="wp6c-integration">
            <directory>Integration/Wp6c</directory>
        </testsuite>
        <testsuite name="wp7-unit">
            <directory>Unit/Wp7</directory>
        </testsuite>
        <testsuite name="wp7-integration">
            <directory>Integration/Wp7</directory>
        </testsuite>
        <testsuite name="wp8-integration">
            <directory>Integration/Wp8</directory>
            <!-- WP8 A2 security gate: FAILS by design while the race is open (A2_RACE_PROVEN) - its own suite below -->
            <exclude>Integration/Wp8/ConcurrentFirstLoginGateTest.php</exclude>
            <exclude>Integration/Wp8/UsernameEquivalenceGateTest.php</exclude>
            <exclude>Integration/Wp8/HotspotEquivalenceGateTest.php</exclude>
        </testsuite>
        <!-- WP8 A2 concurrent first-login race gate (real NAS lab, production contract). Owner 2026-10-09: evidence
             ACCEPTED, SECURITY GATE FAILED - RACE_PROVEN. The suite is EXPECTED TO FAIL until the A2-R remediation is
             implemented and re-gated; it is never part of a "green" regression run and its failure is never waived. -->
        <testsuite name="wp8-security-gates">
            <file>Integration/Wp8/ConcurrentFirstLoginGateTest.php</file>
            <file>Integration/Wp8/UsernameEquivalenceGateTest.php</file>
            <file>Integration/Wp8/HotspotEquivalenceGateTest.php</file>
        </testsuite>
        <testsuite name="hotfix-pace-unit">
            <directory>Unit/HotfixPaceXhrCsrf</directory>
        </testsuite>
    </testsuites>
</phpunit>
