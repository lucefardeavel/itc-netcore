   │ <script>\n
   │     document.addEventListener("DOMContentLoaded", function() {\n
   │         // Function to toggle visibility of custom tax rate input field\n
   │         function toggleCustomTaxRate() {\n
   │             var taxRateSelect = document.getElementById("tax_rate");\n
   │             var customTaxRateInput = document.getElementById("customTaxRate");\n
   │ \n
   │             if (taxRateSelect.value === "custom") {\n
   │                 customTaxRateInput.style.display = "block";\n
   │             } else {\n
   │                 customTaxRateInput.style.display = "none";\n
   │             }\n
   │         }\n
   │ \n
   │         // Call the function when the page loads\n
   │         toggleCustomTaxRate();\n
   │ \n
   │         // Call the function whenever the tax rate dropdown value changes\n
   │         document.getElementById("tax_rate").addEventListener("change", toggleCustomTaxRate);\n
   │     });\n
   │ </script>\n
