        // WP8 A4 time contract: epochs from the RADIUS database session (AccountingService), never PHP-local parsing\n
        $start = AccountingService::epoch($row['acctstart_epoch'] ?? null);\n
        $seen = ($row['acctupdatetime'] ?? null) !== null ? AccountingService::epoch($row['acctupdate_epoch'] ?? null) : $start;\n
        $stop = ($row['acctstoptime'] ?? null) !== null ? AccountingService::epoch($row['acctstop_epoch'] ?? null) : null;\n
        $out = [\n
            'state' => self::sessionState($open !== [], $seen, time()), 'open_sessions' => count($open), 'username' => (string) $row['username'],\n
            'started' => self::displayTime($start) ?? '', 'last_update' => self::displayTime($seen) ?? '',\n
            'stopped' => ($row['acctstoptime'] ?? null) !== null ? (self::displayTime($stop) ?? '') : null,\n
            'started_epoch' => $start, 'last_update_epoch' => $seen, 'stopped_epoch' => $stop,\n
            'framed_ip' => (string) $row['framedipaddress'], 'mac' => (string) ($row['callingstationid'] ?? ''),\n
            'session_seconds' => (int) $row['acctsessiontime'], 'download' => (int) $row['acctoutputoctets'], 'upload' => (int) $row['acctinputoctets'],\n
        ];\n
        if ($nas) {\n
            $out['nas'] = (string) $row['nasipaddress'];\n
        }\n
        return $out;\n
    }\n
\n
    /**\n
     * State of the newest session from its last accounting instant ($seen: epoch of the last update, else the start):\n
     * offline when closed; otherwise online only when the time is valid, not older than STALE_SECONDS and not further in\n
     * the future than the clock tolerance. A missing, invalid or future time is "stale" (shown as status unknown).\n
     */\n
    public static function sessionState(bool $open, ?int $seen, int $now): string\n
    {\n
        if (!$open) {\n
            return 'offline';\n
        }\n
        if ($seen === null || $seen <= 0 || $seen - $now > AccountingService::CLOCK_TOLERANCE_SECONDS) {\n
            return 'stale';\n
        }\n
        return $now - $seen > self::STALE_SECONDS ? 'stale' : 'online';\n
    }\n
\n
    /** an accounting instant in the application zone with its UTC offset ("2026-10-13 12:35:13 UTC+03:00"), or null */\n
    public static function displayTime(?int $epoch): ?string\n
    {\n
        return $epoch === null || $epoch <= 0 ? null : date('Y-m-d H:i:s \U\T\CP', $epoch);\n
    }\n
\n
    /**\n
     * Activation customer picker: reseller-owned customers matching the term within customer.read scope that the\n
     * actor may activate (ActivationService::payerOf: Agent own customers, Sales assigned, Admin any), at most 20.\n
     *\n
     * @return list<array<string,mixed>>\n
     */\n
    public static function activatable(\Reseller\Security\ActorContext $a, string $term): array\n
    {\n
        [$pred, $params] = CustomerSearch::predicate($term, 'tbl_customers', false, self::sessionUsernames($term));\n
        $rows = \Reseller\Security\DataScope::scopeCustomers(\ORM::for_table('tbl_customers'), $a, \Reseller\Security\Capability::CUSTOMER_READ)\n
            ->where_raw($pred, $params)->where_not_null('tbl_customers.manager_id')\n
            ->order_by_asc('tbl_customers.username')->limit(40)->find_array();\n
        $out = [];\n
        foreach ($rows as $r) {\n
            try {\n
                \Reseller\Activation\ActivationService::payerOf($a, $r);\n
            } catch (\Reseller\Domain\DomainError) {\n
                continue;\n
            }\n
            $out[] = ['id' => (int) $r['id'], 'username' => (string) $r['username'], 'fullname' => (string) $r['fullname'], 'status' => (string) $r['status'],\n
                'phonenumber' => (string) $r['phonenumber'], 'pppoe_ip' => (string) $r['pppoe_ip']];\n
            if (count($out) >= 20) {\n
                break;\n
            }\n
        }\n
        return $out;\n
    }\n
\n
    /**\n
     * Display data of the actor's activation catalog (no price: the effective prices come only from the server quote).\n
     *\n
     * @param list<array{id:int,name_plan:string,type:string}> $catalog\n
     * @return list<array<string,mixed>>\n
     */\n
    public static function planCards(array $catalog): array\n
    {\n
        $ids = array_map(static fn(array $p): int => (int) $p['id'], $catalog);\n
        if ($ids === []) {\n
            return [];\n
        }\n
        $extra = [];\n
        foreach (\ORM::for_table('tbl_plans')->select_many('tbl_plans.id', 'tbl_plans.validity', 'tbl_plans.validity_unit')->select('tbl_bandwidth.name_bw', 'name_bw')\n
            ->left_outer_join('tbl_bandwidth', ['tbl_bandwidth.id', '=', 'tbl_plans.id_bw'])->where_in('tbl_plans.id', $ids)->find_array() as $r) {\n
            $extra[(int) $r['id']] = $r;\n
        }\n
        return array_map(static fn(array $p): array => $p + ['validity' => (string) ($extra[$p['id']]['validity'] ?? ''), 'validity_unit' => (string) ($extra[$p['id']]['validity_unit'] ?? ''),\n
            'speed' => (string) ($extra[$p['id']]['name_bw'] ?? '')], $catalog);\n
    }\n
}\n
